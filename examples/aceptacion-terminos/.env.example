# API key de sygners ("Mi plan" → Integración (API)). sgn_test_… para stage.
SYGNERS_API_KEY=
# Opcional: otra URL de la API (por ejemplo, stage).
# SYGNERS_BASE_URL=https://stage.sygners.com
# Opcional: dónde se firma en sygners; {documentoId} se reemplaza.
# Default: <SYGNERS_BASE_URL>/sign/{documentoId}
# SYGNERS_URL_FIRMA=https://sygners.com/sign/{documentoId}
# Opcional: firmantes que se suman siempre, separados por coma.
# FIRMANTES_EXTRA=legales@tuempresa.com
# PORT=3000
